{
  "info": {
    "_postman_id": "f04653f4-2539-4fd2-a670-98b1e7ca9544",
    "name": "HotelBooking - Create Booking API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5001"
    }
  ],
  "item": [
    {
      "name": "Create Booking - Success (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date();",
              "start.setDate(start.getDate() + 22);",
              "const end = new Date(start);",
              "end.setDate(start.getDate() + 1);",
              "pm.collectionVariables.set('successStartDate', start.toISOString().split('T')[0]);",
              "pm.collectionVariables.set('successEndDate', end.toISOString().split('T')[0]);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Response body is booking JSON', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('customerId');",
              "  pm.expect(body).to.have.property('roomId');",
              "  pm.expect(body.isActive).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"{{successStartDate}}\",\n  \"endDate\": \"{{successEndDate}}\",\n  \"customerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Booking - Conflict (409)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date();",
              "start.setDate(start.getDate() + 6);",
              "const end = new Date();",
              "end.setDate(end.getDate() + 8);",
              "pm.collectionVariables.set('conflictStartDate', start.toISOString().split('T')[0]);",
              "pm.collectionVariables.set('conflictEndDate', end.toISOString().split('T')[0]);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 409', function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test('Conflict message explains no availability', function () {",
              "  pm.expect(pm.response.text()).to.include('could not be created');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"{{conflictStartDate}}\",\n  \"endDate\": \"{{conflictEndDate}}\",\n  \"customerId\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Booking - Invalid Date (400)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const today = new Date();",
              "pm.collectionVariables.set('invalidDate', today.toISOString().split('T')[0]);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Validation message exists', function () {",
              "  pm.expect(pm.response.text().length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"{{invalidDate}}\",\n  \"endDate\": \"{{invalidDate}}\",\n  \"customerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      },
      "response": []
    }
  ]
}